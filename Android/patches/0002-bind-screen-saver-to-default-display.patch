+package com.aliothmoon.maafw.overlay.screensaver
+
+import android.content.Context
+import android.hardware.display.DisplayManager
+import android.view.Display
+import android.view.WindowManager
+import io.mockk.every
+import io.mockk.mockk
+import io.mockk.verify
+import org.junit.Assert.assertSame
+import org.junit.Assert.assertThrows
+import org.junit.Test
+
+/** 模拟当前焦点已在游戏虚拟屏，验证屏保仍只使用默认物理屏的窗口服务。 */
+class ScreenSaverWindowHostTest {
+    private val original = mockk<Context>()
+    private val displays = mockk<DisplayManager>()
+    private val primary = mockk<Display>()
+    private val displayContext = mockk<Context>()
+    private val windowContext = mockk<Context>()
+    private val primaryWindows = mockk<WindowManager>()
+    private val virtualWindows = mockk<WindowManager>()
+
+    private fun prepare() {
+        every { original.getSystemService(Context.DISPLAY_SERVICE) } returns displays
+        // 错用 application 的 WindowManager 会拿到虚拟屏服务，不能只验证“拿到了一个管理器”。
+        every { original.getSystemService(Context.WINDOW_SERVICE) } returns virtualWindows
+        every { displays.getDisplay(Display.DEFAULT_DISPLAY) } returns primary
+        every { primary.displayId } returns Display.DEFAULT_DISPLAY
+        every { original.createDisplayContext(primary) } returns displayContext
+        every { displayContext.createWindowContext(WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY, null) } returns windowContext
+        every { displayContext.display } returns primary
+        every { windowContext.display } returns primary
+        every { primaryWindows.defaultDisplay } returns primary
+        every { displayContext.getSystemService(Context.WINDOW_SERVICE) } returns primaryWindows
+        every { windowContext.getSystemService(Context.WINDOW_SERVICE) } returns primaryWindows
+    }
+
+    @Test
+    fun `Android 30 and newer use default display overlay window context`() {
+        for (sdk in listOf(30, 32, 34)) {
+            prepare()
+            val host = createScreenSaverWindowHost(original, sdk)
+
+            assertSame(windowContext, host.context)
+            assertSame(primaryWindows, host.windowManager)
+        }
+        verify(exactly = 3) { displays.getDisplay(Display.DEFAULT_DISPLAY) }
+        verify(exactly = 3) { original.createDisplayContext(primary) }
+        verify(exactly = 3) { displayContext.createWindowContext(WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY, null) }
+        verify(exactly = 0) { original.getSystemService(Context.WINDOW_SERVICE) }
+    }
+
+    @Test
+    fun `Android 29 uses default display context without calling newer window context API`() {
+        prepare()
+        val host = createScreenSaverWindowHost(original, 29)
+
+        assertSame(displayContext, host.context)
+        assertSame(primaryWindows, host.windowManager)
+        verify(exactly = 0) { displayContext.createWindowContext(any(), any()) }
+        verify(exactly = 0) { original.getSystemService(Context.WINDOW_SERVICE) }
+    }
+
+    @Test
+    fun `missing default display fails without using a virtual display or application windows`() {
+        prepare()
+        every { displays.getDisplay(Display.DEFAULT_DISPLAY) } returns null
+
+        assertThrows(IllegalStateException::class.java) { createScreenSaverWindowHost(original, 32) }
+
+        verify(exactly = 0) { original.createDisplayContext(any()) }
+        verify(exactly = 0) { original.getSystemService(Context.WINDOW_SERVICE) }
+    }
+
+    @Test
+    fun `failed window context creation does not fall back to application windows`() {
+        prepare()
+        every { displayContext.createWindowContext(WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY, null) } throws IllegalArgumentException("display removed")
+
+        assertThrows(IllegalArgumentException::class.java) { createScreenSaverWindowHost(original, 32) }
+
+        verify(exactly = 0) { original.getSystemService(Context.WINDOW_SERVICE) }
+        verify(exactly = 0) { displayContext.getSystemService(Context.WINDOW_SERVICE) }
+    }
+}
