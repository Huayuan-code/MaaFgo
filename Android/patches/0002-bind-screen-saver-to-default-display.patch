+
+/** View 与 WindowManager 必须来自同一块物理主屏的窗口 Context。 */
+internal data class ScreenSaverWindowHost(val context: Context, val windowManager: WindowManager)
+
+internal fun createScreenSaverWindowHost(
+    context: Context,
+    sdkInt: Int = Build.VERSION.SDK_INT,
+): ScreenSaverWindowHost {
+    val displays = context.getSystemService(Context.DISPLAY_SERVICE) as? DisplayManager
+        ?: error("DisplayManager unavailable for screen saver")
+    val primary = displays.getDisplay(Display.DEFAULT_DISPLAY)
+        ?: error("Default display unavailable for screen saver")
+    traceScreenSaver("host-request api=$sdkInt requestedDisplay=" + Display.DEFAULT_DISPLAY +
+        " actualDisplay=" + primary.displayId + " original=" + describeScreenSaverContext(context, sdkInt))
+    val displayContext = context.createDisplayContext(primary)
+    traceScreenSaver("display-context " + describeScreenSaverContext(displayContext, sdkInt))
+    // API 30 的双参数重载需先有 DisplayContext；直接传 Display 的重载要到 API 31 才存在。
+    // API 29 沿用带显式 Display 的 WindowManager；不可回退到可能指向游戏虚拟屏的 Application Context。
+    val windowContext = if (sdkInt >= Build.VERSION_CODES.R) {
+        displayContext.createWindowContext(WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY, null)
+    } else {
+        displayContext
+    }
+    val windows = windowContext.getSystemService(Context.WINDOW_SERVICE) as? WindowManager
+        ?: error("WindowManager unavailable for screen saver")
+    traceScreenSaver("window-host route=" + (if (sdkInt >= Build.VERSION_CODES.R) "createWindowContext(type)" else "displayContext") +
+        " context=" + describeScreenSaverContext(windowContext, sdkInt) + " wm=" + describeScreenSaverWindows(windows))
+    return ScreenSaverWindowHost(windowContext, windows)
+}
+
+/** 诊断只读取 Context/WindowManager，不改变 token 或 display；日志失败不能影响屏保。 */
+private fun traceScreenSaver(message: String) {
+    runCatching { Ln.i("ScreenSaverDisplay: $message") }
+    runCatching { Timber.i("ScreenSaverDisplay: %s", message) }
+}
+
+private fun describeScreenSaverContext(context: Context, sdkInt: Int = Build.VERSION.SDK_INT): String {
+    val display = if (sdkInt >= Build.VERSION_CODES.R) {
+        screenSaverValue { context.display?.displayId }
+    } else "api<30"
+    val token = screenSaverValue { context.javaClass.getMethod("getWindowContextToken").invoke(context) }
+    return context.javaClass.name + " display=" + display + " contextToken=" + token
+}
+
+@Suppress("DEPRECATION")
+private fun describeScreenSaverWindows(windows: WindowManager): String =
+    windows.javaClass.name + " defaultDisplay=" + screenSaverValue { windows.defaultDisplay.displayId } +
+        " mContext=" + screenSaverField(windows, "mContext") +
+        " mDefaultToken=" + screenSaverField(windows, "mDefaultToken") +
+        " mWindowContextToken=" + screenSaverField(windows, "mWindowContextToken") +
+        " mParentWindow=" + screenSaverField(windows, "mParentWindow")
+
+private fun describeScreenSaverParams(params: WindowManager.LayoutParams): String =
+    "type=" + params.type + " token=" + params.token +
+        " windowContextToken=" + screenSaverField(params, "mWindowContextToken")
+
+private inline fun screenSaverValue(read: () -> Any?): String = try {
+    read()?.toString() ?: "null"
+} catch (error: Throwable) {
+    "unavailable:" + error.javaClass.simpleName
+}
+
+private fun screenSaverField(instance: Any, name: String): String = screenSaverValue {
+    var type: Class<*>? = instance.javaClass
+    var field: java.lang.reflect.Field? = null
+    while (type != null && field == null) {
+        val candidate = type
+        field = runCatching { candidate.getDeclaredField(name) }.getOrNull()
+        type = candidate.superclass
+    }
+    if (field == null) "no-field" else field.also { it.isAccessible = true }.get(instance)
+}
