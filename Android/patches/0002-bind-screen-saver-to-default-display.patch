+
+/** View、WindowManager 与 IWindow 父 token 均来自同一个可见主 Activity。 */
+internal data class ScreenSaverWindowHost(
+    val context: Context,
+    val windowManager: WindowManager,
+    val parentWindowToken: IBinder,
+    val windowType: Int = WindowManager.LayoutParams.TYPE_APPLICATION_PANEL,
+)
+
+/** Application 单例只保存弱引用；Activity 重建时旧 AppRoot 的解绑不能清掉新宿主。 */
+internal class ScreenSaverActivityAnchor {
+    private var activity = WeakReference<Activity>(null)
+
+    fun bind(host: Activity) { activity = WeakReference(host) }
+    fun current(): Activity? = activity.get()
+    fun unbind(host: Activity): Boolean {
+        if (activity.get() !== host) return false
+        activity.clear()
+        return true
+    }
+
+}
+
+/** OEM 仍挂错屏时立即隐藏、撤窗，避免黑色屏保持续遮挡游戏识别。 */
+internal fun keepScreenSaverOnPrimaryDisplay(view: View, windows: WindowManager): Boolean {
+    val actualDisplay = view.display?.displayId
+    if (actualDisplay == Display.DEFAULT_DISPLAY) return true
+    traceScreenSaver("reject-attached-display actual=$actualDisplay expected=" + Display.DEFAULT_DISPLAY)
+    view.visibility = View.GONE
+    runCatching { windows.removeViewImmediate(view) }
+        .onFailure { traceScreenSaver("reject-attached-display remove failed: " + it.javaClass.simpleName) }
+    return false
+}
+
+@Suppress("DEPRECATION")
+internal fun createScreenSaverWindowHost(
+    activity: Activity?,
+    sdkInt: Int = Build.VERSION.SDK_INT,
+): ScreenSaverWindowHost {
+    check(activity != null && !activity.isFinishing && !activity.isDestroyed) {
+        "No live primary Activity for screen saver"
+    }
+    val windows = activity.windowManager
+    val displayId = if (sdkInt >= Build.VERSION_CODES.R) activity.display?.displayId
+        else windows.defaultDisplay.displayId
+    check(displayId == Display.DEFAULT_DISPLAY) { "Screen saver Activity is not on the primary display: $displayId" }
+    val decor = activity.window.decorView
+    check(decor.isAttachedToWindow && decor.isShown && decor.windowVisibility == View.VISIBLE) {
+        "Screen saver Activity window is not visible"
+    }
+    check(decor.display?.displayId == Display.DEFAULT_DISPLAY) { "Screen saver parent window is not on the primary display" }
+    // TYPE_APPLICATION_PANEL 要求父 IWindow token，不是用于 2038 的 ActivityRecord application token。
+    val parentToken = checkNotNull(decor.windowToken) { "Screen saver parent window token is unavailable" }
+    traceScreenSaver("window-host route=activity-panel api=$sdkInt type=" + WindowManager.LayoutParams.TYPE_APPLICATION_PANEL +
+        " context=" + describeScreenSaverContext(activity, sdkInt) + " parentWindowToken=" + parentToken +
+        " wm=" + describeScreenSaverWindows(windows))
+    return ScreenSaverWindowHost(activity, windows, parentToken)
+}
+
+/** 诊断只读取 Context/WindowManager，不改变 token 或 display；日志失败不能影响屏保。 */
+private fun traceScreenSaver(message: String) {
+    runCatching { Ln.i("ScreenSaverDisplay: $message") }
+    runCatching { Timber.i("ScreenSaverDisplay: %s", message) }
+}
+
+private fun describeScreenSaverContext(context: Context, sdkInt: Int = Build.VERSION.SDK_INT): String {
+    val display = if (sdkInt >= Build.VERSION_CODES.R) {
+        screenSaverValue { context.display?.displayId }
+    } else "api<30"
+    val token = screenSaverValue { context.javaClass.getMethod("getWindowContextToken").invoke(context) }
+    return context.javaClass.name + " display=" + display + " contextToken=" + token
+}
+
+@Suppress("DEPRECATION")
+private fun describeScreenSaverWindows(windows: WindowManager): String =
+    windows.javaClass.name + " defaultDisplay=" + screenSaverValue { windows.defaultDisplay.displayId } +
+        " mContext=" + screenSaverField(windows, "mContext") +
+        " mDefaultToken=" + screenSaverField(windows, "mDefaultToken") +
+        " mWindowContextToken=" + screenSaverField(windows, "mWindowContextToken") +
+        " mParentWindow=" + screenSaverField(windows, "mParentWindow")
+
+private fun describeScreenSaverParams(params: WindowManager.LayoutParams): String =
+    "type=" + params.type + " token=" + params.token +
+        " windowContextToken=" + screenSaverField(params, "mWindowContextToken")
+
+private inline fun screenSaverValue(read: () -> Any?): String = try {
+    read()?.toString() ?: "null"
+} catch (error: Throwable) {
+    "unavailable:" + error.javaClass.simpleName
+}
+
+private fun screenSaverField(instance: Any, name: String): String = screenSaverValue {
+    var type: Class<*>? = instance.javaClass
+    var field: java.lang.reflect.Field? = null
+    while (type != null && field == null) {
+        val candidate = type
+        field = runCatching { candidate.getDeclaredField(name) }.getOrNull()
+        type = candidate.superclass
+    }
+    if (field == null) "no-field" else field.also { it.isAccessible = true }.get(instance)
+}
