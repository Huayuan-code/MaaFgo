+package com.aliothmoon.maafw.overlay.screensaver
+
+import android.app.Activity
+import android.os.IBinder
+import android.view.Display
+import android.view.View
+import android.view.Window
+import android.view.WindowManager
+import io.mockk.every
+import io.mockk.just
+import io.mockk.mockk
+import io.mockk.Runs
+import io.mockk.verify
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertSame
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class ScreenSaverActivityAnchorTest {
+    private val activity = mockk<Activity>()
+    private val display = mockk<Display>()
+    private val window = mockk<Window>()
+    private val windows = mockk<WindowManager>()
+    private val params = mockk<WindowManager.LayoutParams>()
+    private val applicationToken = mockk<IBinder>()
+
+    private fun prepareActivity(displayId: Int = Display.DEFAULT_DISPLAY) {
+        every { activity.isFinishing } returns false
+        every { activity.isDestroyed } returns false
+        every { activity.display } returns display
+        every { activity.windowManager } returns windows
+        every { windows.defaultDisplay } returns display
+        every { display.displayId } returns displayId
+        every { activity.window } returns window
+        every { window.attributes } returns params
+        params.token = applicationToken
+    }
+
+    @Test
+    fun `uses ActivityRecord application token rather than the decor IWindow token`() {
+        prepareActivity()
+        val anchor = ScreenSaverActivityAnchor()
+        anchor.bind(activity)
+
+        assertSame(applicationToken, anchor.applicationToken(32))
+        verify(exactly = 0) { window.decorView }
+    }
+
+    @Test
+    fun `Android 29 validates the physical Activity display through its WindowManager`() {
+        prepareActivity()
+
+        assertSame(applicationToken, primaryScreenSaverApplicationToken(activity, 29))
+        verify(exactly = 0) { activity.display }
+    }
+
+    @Test
+    fun `missing destroyed finishing or nonphysical activity safely refuses a token`() {
+        assertNull(primaryScreenSaverApplicationToken(null, 32))
+        prepareActivity(9)
+        assertNull(primaryScreenSaverApplicationToken(activity, 32))
+        verify(exactly = 0) { window.attributes }
+
+        prepareActivity()
+        every { activity.isDestroyed } returns true
+        assertNull(primaryScreenSaverApplicationToken(activity, 32))
+        every { activity.isDestroyed } returns false
+        every { activity.isFinishing } returns true
+        assertNull(primaryScreenSaverApplicationToken(activity, 32))
+    }
+
+    @Test
+    fun `missing application token refuses display instead of falling back to another token`() {
+        prepareActivity()
+        params.token = null
+
+        assertNull(primaryScreenSaverApplicationToken(activity, 32))
+        verify(exactly = 0) { window.decorView }
+    }
+
+    @Test
+    fun `disposing an old AppRoot cannot unbind the replacement Activity`() {
+        val oldActivity = mockk<Activity>()
+        val anchor = ScreenSaverActivityAnchor()
+        anchor.bind(oldActivity)
+        anchor.bind(activity)
+
+        assertFalse(anchor.unbind(oldActivity))
+        assertSame(activity, anchor.current())
+        assertTrue(anchor.unbind(activity))
+        assertNull(anchor.current())
+        assertNull(anchor.applicationToken(32))
+    }
+
+    @Test
+    fun `wrong actual display is hidden and removed immediately`() {
+        val view = mockk<View>()
+        every { view.display } returns display
+        every { display.displayId } returns 9
+        every { view.visibility = View.GONE } just Runs
+        every { windows.removeViewImmediate(view) } just Runs
+
+        assertFalse(keepScreenSaverOnPrimaryDisplay(view, windows))
+        verify(exactly = 1) { view.visibility = View.GONE }
+        verify(exactly = 1) { windows.removeViewImmediate(view) }
+    }
+
+    @Test
+    fun `correct actual display keeps the screen saver window`() {
+        val view = mockk<View>()
+        every { view.display } returns display
+        every { display.displayId } returns Display.DEFAULT_DISPLAY
+
+        assertTrue(keepScreenSaverOnPrimaryDisplay(view, windows))
+        verify(exactly = 0) { windows.removeViewImmediate(any()) }
+    }
+}
