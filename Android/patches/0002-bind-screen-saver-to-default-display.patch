+
+/** 子窗口必须使用父 IWindow token；2038 的 ActivityRecord token 不能混入新路径。 */
+class ScreenSaverWindowHostTest {
+    private val activity = mockk<Activity>()
+    private val primary = mockk<Display>()
+    private val window = mockk<Window>()
+    private val decor = mockk<View>()
+    private val windows = mockk<WindowManager>()
+    private val applicationParams = mockk<WindowManager.LayoutParams>()
+    private val applicationToken = mockk<IBinder>()
+    private val parentWindowToken = mockk<IBinder>()
+
+    private fun prepare() {
+        every { activity.isFinishing } returns false
+        every { activity.isDestroyed } returns false
+        every { activity.display } returns primary
+        every { activity.windowManager } returns windows
+        every { windows.defaultDisplay } returns primary
+        every { primary.displayId } returns Display.DEFAULT_DISPLAY
+        every { activity.window } returns window
+        every { window.decorView } returns decor
+        every { window.attributes } returns applicationParams
+        applicationParams.token = applicationToken
+        every { decor.isAttachedToWindow } returns true
+        every { decor.isShown } returns true
+        every { decor.windowVisibility } returns View.VISIBLE
+        every { decor.display } returns primary
+        every { decor.windowToken } returns parentWindowToken
+    }
+
+    @Test
+    fun `visible primary Activity uses panel type IWindow token and its own window manager`() {
+        prepare()
+        val host = createScreenSaverWindowHost(activity, 32)
+
+        assertSame(activity, host.context)
+        assertSame(windows, host.windowManager)
+        assertSame(parentWindowToken, host.parentWindowToken)
+        assertNotEquals(applicationToken, host.parentWindowToken)
+        assertEquals(WindowManager.LayoutParams.TYPE_APPLICATION_PANEL, host.windowType)
+        assertNotEquals(WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY, host.windowType)
+        verify(exactly = 0) { window.attributes }
+        verify(exactly = 0) { activity.createWindowContext(any(), any()) }
+    }
+
+    @Test
+    fun `Android 29 uses the Activity display without calling API 30 methods`() {
+        prepare()
+        val host = createScreenSaverWindowHost(activity, 29)
+
+        assertSame(parentWindowToken, host.parentWindowToken)
+        assertEquals(WindowManager.LayoutParams.TYPE_APPLICATION_PANEL, host.windowType)
+        verify(exactly = 0) { activity.display }
+        verify(exactly = 0) { activity.createWindowContext(any(), any()) }
+    }
+
+    @Test
+    fun `missing finishing or destroyed Activity is refused`() {
+        assertThrows(IllegalStateException::class.java) { createScreenSaverWindowHost(null, 32) }
+        prepare()
+        every { activity.isFinishing } returns true
+        assertThrows(IllegalStateException::class.java) { createScreenSaverWindowHost(activity, 32) }
+        every { activity.isFinishing } returns false
+        every { activity.isDestroyed } returns true
+        assertThrows(IllegalStateException::class.java) { createScreenSaverWindowHost(activity, 32) }
+    }
+
+    @Test
+    fun `Activity on a game display cannot supply the screen saver host`() {
+        prepare()
+        every { primary.displayId } returns 10
+
+        assertThrows(IllegalStateException::class.java) { createScreenSaverWindowHost(activity, 32) }
+        verify(exactly = 0) { window.decorView }
+    }
+
+    @Test
+    fun `invisible or detached Activity parent window is refused`() {
+        prepare()
+        every { decor.isShown } returns false
+        assertThrows(IllegalStateException::class.java) { createScreenSaverWindowHost(activity, 32) }
+        every { decor.isShown } returns true
+        every { decor.isAttachedToWindow } returns false
+        assertThrows(IllegalStateException::class.java) { createScreenSaverWindowHost(activity, 32) }
+        every { decor.isAttachedToWindow } returns true
+        every { decor.windowVisibility } returns View.GONE
+        assertThrows(IllegalStateException::class.java) { createScreenSaverWindowHost(activity, 32) }
+    }
+
+    @Test
+    fun `missing parent IWindow token does not fall back to the application token`() {
+        prepare()
+        every { decor.windowToken } returns null
+
+        assertThrows(IllegalStateException::class.java) { createScreenSaverWindowHost(activity, 32) }
+        verify(exactly = 0) { window.attributes }
+    }
+
+    @Test
+    fun `parent decor on a different display is refused even when context says primary`() {
+        prepare()
+        val gameDisplay = mockk<Display>()
+        every { gameDisplay.displayId } returns 10
+        every { decor.display } returns gameDisplay
+
+        assertThrows(IllegalStateException::class.java) { createScreenSaverWindowHost(activity, 32) }
+    }
+}
